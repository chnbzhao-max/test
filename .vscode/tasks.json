{
  "version": "2.0.0",
  "tasks": [
    {"label": "Install dependencies in selected interpreter", "type": "process", "command": "${command:python.interpreterPath}", "args": ["-m", "pip", "install", "-r", "requirements.txt"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Run all tests", "type": "process", "command": "${command:python.interpreterPath}", "args": ["-m", "unittest", "discover", "-s", "tests", "-v"], "options": {"cwd": "${workspaceFolder}"}, "group": {"kind": "test", "isDefault": true}, "problemMatcher": []},
    {"label": "Prepare offline presentation", "type": "process", "command": "${command:python.interpreterPath}", "args": ["prepare_demo.py"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ]
}
