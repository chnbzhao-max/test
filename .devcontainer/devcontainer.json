{
  "name": "Westminster Planning Leads",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "forwardPorts": [8000, 8002],
  "portsAttributes": {
    "8000": {"label": "Planning Leads", "onAutoForward": "notify"},
    "8002": {"label": "Independent Review", "onAutoForward": "notify"}
  },
  "customizations": {"vscode": {"settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}}}
}
